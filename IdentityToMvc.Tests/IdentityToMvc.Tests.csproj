<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The tests are short; passing the xUnit cancellation token everywhere would only add noise -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--#if (TemplateSourceOnly) -->
  <!-- Same feature switches as the web project (see IdentityToMvc.Web.csproj) -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);Profile;EmailChange;PersonalData;UnlockLink;BreachedPasswords;TwoFactor;Sudo;Passkeys;ExternalLogins;Google;Facebook;Notifications;Devices;Activity;Admin;AdminRequiresMfa;LangSr;LangEn;LangBoth;DbSqlServer</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

  <ItemGroup>
    <ProjectReference Include="..\IdentityToMvc.Web\IdentityToMvc.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
