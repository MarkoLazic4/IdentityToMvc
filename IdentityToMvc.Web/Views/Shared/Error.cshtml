@model ErrorViewModel
@{
    ViewData["Title"] = L["Error"].Value;
}

<div class="card status-page">
    <span class="icon-badge icon-badge-danger"><i class="bi bi-exclamation-octagon"></i></span>
    <h1>@L["Something went wrong"]</h1>
    <p>@L["An error occurred while processing your request. Please try again in a moment."]</p>

    @if (Model.ShowRequestId)
    {
        <p class="small mb-4">
            @L["Request ID:"] <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> @L["Back to home"]</a>
</div>
