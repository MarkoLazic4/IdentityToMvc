@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject Microsoft.Extensions.Options.IOptionsMonitor<SecurityOptions> SecurityOptions
@{
    ViewData["Title"] = L["Home"].Value;
    var signedIn = SignInManager.IsSignedIn(User);
}

<section class="hero">
    <span class="pill mb-4"><i class="bi bi-stars"></i> ASP.NET Core Identity &middot; .NET 10</span>
    <h1>@L["Identity, rebuilt the"] <span class="text-gradient">@L["MVC way"]</span></h1>
    <p class="lead">
        @L["The complete ASP.NET Core Identity UI - registration, login, two-factor authentication and account management - migrated from Razor Pages to plain MVC controllers and views."]
    </p>
    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
        @if (signedIn)
        {
            <a class="btn btn-primary btn-lg px-4" asp-area="User" asp-controller="Manage" asp-action="Index">
                <i class="bi bi-person-gear me-1"></i> @L["Manage your account"]
            </a>
            @if (SecurityOptions.CurrentValue.EnableTwoFactor)
            {
                <a class="btn btn-outline-primary btn-lg px-4" asp-area="User" asp-controller="Manage" asp-action="TwoFactorAuthentication">
                    <i class="bi bi-shield-check me-1"></i> @L["Security settings"]
                </a>
            }
        }
        else
        {
            <a class="btn btn-primary btn-lg px-4" asp-area="User" asp-controller="Account" asp-action="Register">
                @L["Create an account"] <i class="bi bi-arrow-right ms-1"></i>
            </a>
            <a class="btn btn-outline-primary btn-lg px-4" asp-area="User" asp-controller="Account" asp-action="Login">
                @L["Log in"]
            </a>
        }
    </div>
</section>

<div class="section-title">
    <h2>@L["Everything Identity ships with"]</h2>
    <p>@L["Every flow from the default Identity UI, as controllers, view models and Razor views."]</p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-person-plus"></i></span>
            <h3>@L["Registration"]</h3>
            <p>@L["Sign up with email confirmation, resend confirmation and a password strength hint."]</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-box-arrow-in-right"></i></span>
            <h3>@L["Login & lockout"]</h3>
            <p>@L["Local and external logins, \"remember me\" and lockout after repeated failed attempts."]</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-shield-lock"></i></span>
            <h3>@L["Two-factor authentication"]</h3>
            <p>@L["Authenticator apps with QR code setup, remembered browsers and one-time recovery codes."]</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-fingerprint"></i></span>
            <h3>@L["Passkeys"]</h3>
            <p>@L["Passwordless, phishing-resistant login with a fingerprint, face or device PIN."]</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-laptop"></i></span>
            <h3>@L["Devices & activity"]</h3>
            <p>@L["See where you're signed in, sign out a single device and review your security history."]</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card feature-card">
            <span class="icon-badge"><i class="bi bi-speedometer2"></i></span>
            <h3>@L["Admin panel"]</h3>
            <p>@L["Manage users and roles, lock accounts and follow every security event in the audit log."]</p>
        </div>
    </div>
</div>

<div class="section-title">
    <h2>@L["How the migration works"]</h2>
    <p>@L["The same Identity services, a different presentation layer."]</p>
</div>

<div class="card p-4 p-md-5">
    <div class="row g-4">
        <div class="col-md-4 d-flex gap-3">
            <span class="step-number">1</span>
            <div>
                <h3 class="h6 mb-1">@L["PageModels become controllers"]</h3>
                <p class="text-muted mb-0">@L["Each Razor Page handler maps to a GET/POST action on AccountController or ManageController."]</p>
            </div>
        </div>
        <div class="col-md-4 d-flex gap-3">
            <span class="step-number">2</span>
            <div>
                <h3 class="h6 mb-1">@L["Bound properties become view models"]</h3>
                <p class="text-muted mb-0">@L["[BindProperty] Input classes live on as strongly typed view models with the same validation."]</p>
            </div>
        </div>
        <div class="col-md-4 d-flex gap-3">
            <span class="step-number">3</span>
            <div>
                <h3 class="h6 mb-1">@L["Pages become views"]</h3>
                <p class="text-muted mb-0">@L["Markup moves to the User area and routes through standard MVC tag helpers."]</p>
            </div>
        </div>
    </div>
</div>
