@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card p-4 p-md-5 mx-auto" style="max-width: 760px;">
    <span class="icon-badge mb-3"><i class="bi bi-shield-check"></i></span>
    <h1 class="h2">@ViewData["Title"]</h1>
    <p class="text-muted">Use this page to detail your site's privacy policy.</p>

    <h2 class="h5 mt-4">What we store</h2>
    <p class="text-muted">
        Your email address, a hashed password, an optional phone number and the security settings you choose
        (such as two-factor authentication and linked external logins).
    </p>

    <h2 class="h5 mt-4">Your rights</h2>
    <p class="text-muted mb-0">
        You can download or permanently delete your personal data at any time from
        <a asp-area="User" asp-controller="Manage" asp-action="PersonalData">Manage account &rarr; Personal data</a>.
    </p>
</div>
