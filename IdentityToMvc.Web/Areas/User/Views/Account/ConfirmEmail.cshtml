@{
    ViewData["Title"] = L["Confirm email"].Value;
    var message = TempData[StatusMessageExtensions.MessageKey] as string;
    var isError = TempData[StatusMessageExtensions.IsErrorKey] as bool? ?? message == null;
}

<div class="card status-page">
    <span class="icon-badge @(isError ? "icon-badge-danger" : "icon-badge-success")">
        <i class="bi @(isError ? "bi-x-circle" : "bi-patch-check")"></i>
    </span>
    <h1>@(isError ? L["Confirmation failed"] : L["Email confirmed"])</h1>
    <p>@(message ?? L["The confirmation link is invalid or has expired."].Value)</p>
    @if (isError)
    {
        <a class="btn btn-primary" asp-area="User" asp-controller="Account" asp-action="ResendEmailConfirmation">@L["Send a new link"]</a>
    }
    else
    {
        <a class="btn btn-primary" asp-area="User" asp-controller="Account" asp-action="Login">@L["Log in"]</a>
    }
</div>
