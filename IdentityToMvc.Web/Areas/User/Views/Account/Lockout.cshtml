@{
    ViewData["Title"] = L["Locked out"].Value;
    var hint = L["Too many failed attempts. For your security this account has been locked - please try again in a few minutes."];
#if (UnlockLink)
    hint = L["Too many failed attempts. For your security this account has been locked - please try again in a few minutes or use the unlock link we emailed you."];
#endif
#if (Passkeys)
    hint = L["Too many failed attempts. For your security this account has been locked - please try again in a few minutes or use a passkey."];
#endif
#if (UnlockLink && Passkeys)
    hint = L["Too many failed attempts. For your security this account has been locked - please try again in a few minutes, use a passkey, or use the unlock link we emailed you."];
#endif
}

<div class="card status-page">
    <span class="icon-badge icon-badge-danger"><i class="bi bi-lock"></i></span>
    <h1>@L["Account temporarily locked"]</h1>
    <p>@hint</p>
    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
        <a class="btn btn-primary" asp-area="User" asp-controller="Account" asp-action="ForgotPassword">@L["Reset password"]</a>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Home" asp-action="Index">@L["Back to home"]</a>
    </div>
</div>
