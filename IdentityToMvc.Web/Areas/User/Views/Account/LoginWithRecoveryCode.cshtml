@model IdentityToMvc.Web.Areas.User.ViewModels.Account.LoginWithRecoveryCodeViewModel
@{
    ViewData["Title"] = "Recovery code verification";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="auth-header">
            <span class="icon-badge icon-badge-warning"><i class="bi bi-life-preserver"></i></span>
            <h1>Use a recovery code</h1>
            <p>Each recovery code can only be used once.</p>
        </div>

        <div class="alert alert-info" role="note">
            <i class="bi bi-info-circle"></i>
            <div>This login won't be remembered until you use an authenticator code or disable 2FA and log in again.</div>
        </div>

        <form method="post" asp-area="User" asp-controller="Account" asp-action="LoginWithRecoveryCode" novalidate>
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-floating mb-4">
                <input asp-for="Input.RecoveryCode" class="form-control code-input" autocomplete="off" placeholder="XXXX-XXXX" autofocus />
                <label asp-for="Input.RecoveryCode">Recovery code</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </form>
    </div>

    <div class="auth-footer">
        <a asp-area="User" asp-controller="Account" asp-action="Login"><i class="bi bi-arrow-left"></i> Back to log in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
