@{
    ViewData["Title"] = L["Check your email"].Value;
}

<div class="card status-page">
    <span class="icon-badge"><i class="bi bi-envelope-paper"></i></span>
    <h1>@L["Check your email"]</h1>
    <p>@L["If an account with a confirmed email exists for that address, we've sent a link to reset your password."]</p>
    <a class="btn btn-primary" asp-area="User" asp-controller="Account" asp-action="Login">@L["Back to log in"]</a>
</div>
