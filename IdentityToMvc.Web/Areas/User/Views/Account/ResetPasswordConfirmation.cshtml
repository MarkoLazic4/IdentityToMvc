@{
    ViewData["Title"] = L["Password reset"].Value;
}

<div class="card status-page">
    <span class="icon-badge icon-badge-success"><i class="bi bi-check2-circle"></i></span>
    <h1>@L["Password reset"]</h1>
    <p>@L["Your password has been reset. You can now log in with your new password."]</p>
    <a class="btn btn-primary" asp-area="User" asp-controller="Account" asp-action="Login">@L["Log in"]</a>
</div>
