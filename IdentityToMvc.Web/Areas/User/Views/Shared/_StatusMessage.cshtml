@model string?

@if (!string.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    <div class="alert alert-@(isError ? "danger" : "success") alert-dismissible fade show" role="alert">
        <i class="bi @(isError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
        <div class="flex-grow-1">@Model</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
