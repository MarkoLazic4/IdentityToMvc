@model (IList<Microsoft.AspNetCore.Authentication.AuthenticationScheme> Providers, string? ReturnUrl, string Verb)

@if (Model.Providers.Count > 0)
{
    <div class="divider">or continue with</div>
    <form id="external-account" asp-area="User" asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div class="d-grid gap-2">
            @foreach (var provider in Model.Providers)
            {
                var icon = provider.Name.ToLowerInvariant() switch
                {
                    "google" => "bi-google",
                    "facebook" => "bi-facebook",
                    "microsoft" => "bi-microsoft",
                    "twitter" => "bi-twitter-x",
                    "github" => "bi-github",
                    _ => "bi-box-arrow-in-right"
                };
                <button type="submit" class="btn btn-provider" name="provider" value="@provider.Name" title="@Model.Verb using your @provider.DisplayName account">
                    <i class="bi @icon"></i> @Model.Verb with @provider.DisplayName
                </button>
            }
        </div>
    </form>
}
