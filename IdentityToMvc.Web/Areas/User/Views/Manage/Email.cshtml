@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.ChangeEmailViewModel
@{
    ViewData["Title"] = L["Manage Email"].Value;
}

<h2 class="page-title">@L["Email"]</h2>
<p class="page-subtitle">@L["The address you log in with and receive account emails at."]</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<form id="email-form" asp-area="User" asp-controller="Manage" asp-action="ChangeEmail" method="post" class="col-xl-8" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert"></div>

    <label class="form-label fw-semibold small text-muted" for="Email">@L["Current email"]</label>
    <div class="input-group mb-2">
        <input asp-for="Email" class="form-control" disabled />
        @if (Model.IsEmailConfirmed)
        {
            <span class="input-group-text text-success"><i class="bi bi-patch-check-fill me-1"></i> @L["Verified"]</span>
        }
        else
        {
            <span class="input-group-text text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i> @L["Not verified"]</span>
        }
    </div>
    @if (!Model.IsEmailConfirmed)
    {
        <button id="email-verification" type="submit" asp-area="User" asp-controller="Manage" asp-action="SendVerificationEmail" formnovalidate class="btn btn-link px-0 mb-3">
            <i class="bi bi-send"></i> @L["Send verification email"]
        </button>
    }

    <div class="form-floating mb-4 mt-3">
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="New email" />
        <label asp-for="Input.NewEmail"></label>
        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
    </div>
    <button id="change-email-button" type="submit" class="btn btn-primary px-4">@L["Change email"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
