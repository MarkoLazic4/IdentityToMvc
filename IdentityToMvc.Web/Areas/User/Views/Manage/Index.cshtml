@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.IndexViewModel
@{
    ViewData["Title"] = "Profile";
}

<h2 class="page-title">Profile</h2>
<p class="page-subtitle">Your basic account information.</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<form id="profile-form" asp-area="User" asp-controller="Manage" asp-action="Index" method="post" class="col-xl-8" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Username" class="form-control" placeholder="Username" disabled />
        <label asp-for="Username">Username</label>
        <div class="form-text">Your username is your email address. Change it on the <a asp-area="User" asp-controller="Manage" asp-action="Email">Email</a> page.</div>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" placeholder="Phone number" />
        <label asp-for="Input.PhoneNumber">Phone number</label>
        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
    </div>
    <button id="update-profile-button" type="submit" class="btn btn-primary px-4">Save changes</button>
</form>

<h3 class="h6 text-muted text-uppercase small mt-5 mb-2">Sessions</h3>
<div class="setting-row">
    <div class="d-flex gap-3 align-items-center">
        <span class="icon-badge icon-badge-warning"><i class="bi bi-laptop"></i></span>
        <div>
            <h3>Sign out of all other devices</h3>
            <p>Ends every other session and forgets remembered 2FA browsers. You stay signed in here.</p>
        </div>
    </div>
    <form id="sign-out-everywhere-form" asp-area="User" asp-controller="Manage" asp-action="SignOutEverywhere" method="post"
          data-confirm="Sign out of all other devices?">
        <button id="sign-out-everywhere" type="submit" class="btn btn-outline-danger">Sign out everywhere</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
