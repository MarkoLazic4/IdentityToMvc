@{
    ViewData["Title"] = L["Reset authenticator key"].Value;
}

<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />
<h2 class="page-title">@L["Reset authenticator key"]</h2>
<p class="page-subtitle">@L["Generate a new key for your authenticator app."]</p>

<div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle"></i>
    <div>
        <strong>@L["Your authenticator app will stop working until you reconfigure it."]</strong>
        <p>@L["This disables 2FA until you verify your authenticator app again. If you don't finish the setup you may lose access to your account."]</p>
    </div>
</div>

<form id="reset-authenticator-form" asp-area="User" asp-controller="Manage" asp-action="ResetAuthenticator" method="post">
    <button id="reset-authenticator-button" class="btn btn-danger" type="submit"><i class="bi bi-arrow-counterclockwise me-1"></i> @L["Reset authenticator key"]</button>
    <a class="btn btn-link" asp-area="User" asp-controller="Manage" asp-action="TwoFactorAuthentication">@L["Cancel"]</a>
</form>
