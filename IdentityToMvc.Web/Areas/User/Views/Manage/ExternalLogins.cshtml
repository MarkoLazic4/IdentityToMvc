@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.ExternalLoginsViewModel
@{
    ViewData["Title"] = "Manage your external logins";
}

<h2 class="page-title">External logins</h2>
<p class="page-subtitle">Services you can use to log in to your account.</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

@if (Model.CurrentLogins?.Count > 0)
{
    <h3 class="h6 text-muted text-uppercase small mb-2">Connected</h3>
    @foreach (var login in Model.CurrentLogins)
    {
        <div class="setting-row">
            <div class="d-flex gap-3 align-items-center">
                <span class="icon-badge"><i class="bi bi-link-45deg"></i></span>
                <div>
                    <h3 id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</h3>
                    <p>Connected</p>
                </div>
            </div>
            @if (Model.ShowRemoveButton)
            {
                <form id="@($"remove-login-{login.LoginProvider}")" asp-area="User" asp-controller="Manage" asp-action="RemoveExternalLogin" method="post">
                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                    <button type="submit" class="btn btn-outline-danger" title="Remove this @login.ProviderDisplayName login from your account">Remove</button>
                </form>
            }
            else
            {
                <span class="small text-muted">Set a password to remove</span>
            }
        </div>
    }
}

@if (Model.OtherLogins?.Count > 0)
{
    <h3 class="h6 text-muted text-uppercase small mt-4 mb-3">Add another service</h3>
    <form id="link-login-form" asp-area="User" asp-controller="Manage" asp-action="LinkLogin" method="post">
        <div id="socialLoginList" class="d-flex flex-wrap gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-provider" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                    <i class="bi bi-plus-lg"></i> @provider.DisplayName
                </button>
            }
        </div>
    </form>
}
