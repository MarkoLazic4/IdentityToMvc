@{
    ViewData["Title"] = L["Confirm email change"].Value;
    var message = TempData[StatusMessageExtensions.MessageKey] as string;
    var isError = TempData[StatusMessageExtensions.IsErrorKey] as bool? ?? message == null;
}

<div class="text-center py-3">
    <span class="icon-badge @(isError ? "icon-badge-danger" : "icon-badge-success") mb-3">
        <i class="bi @(isError ? "bi-x-circle" : "bi-patch-check")"></i>
    </span>
    <h2 class="page-title">@(isError ? L["Email change failed"] : L["Email changed"])</h2>
    <p class="text-muted">@(message ?? L["Error changing email."].Value)</p>
    <a class="btn btn-primary" asp-area="User" asp-controller="Manage" asp-action="Email">@L["Back to email settings"]</a>
</div>
