@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.EnableAuthenticatorViewModel
@{
    ViewData["Title"] = "Configure authenticator app";
}

<h2 class="page-title">Configure authenticator app</h2>
<p class="page-subtitle">Three quick steps to turn on two-factor authentication.</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<ol class="steps">
    <li>
        <span class="step-number">1</span>
        <div>
            <h3 class="h6">Install an authenticator app</h3>
            <p class="text-muted mb-0">
                For example Microsoft Authenticator
                (<a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank" rel="noopener">Android</a>,
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank" rel="noopener">iOS</a>)
                or Google Authenticator
                (<a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" target="_blank" rel="noopener">Android</a>,
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" target="_blank" rel="noopener">iOS</a>).
            </p>
        </div>
    </li>
    <li>
        <span class="step-number">2</span>
        <div class="min-w-0">
            <h3 class="h6">Scan the QR code</h3>
            <p class="text-muted">Or enter this key manually - spaces and casing don't matter.</p>
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
                <div class="qr-box"><div id="qrCode" aria-label="QR code for your authenticator app"></div></div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <kbd class="shared-key" id="shared-key" data-copy-text="@Model.SharedKey">@Model.SharedKey</kbd>
                    <button type="button" class="btn btn-soft btn-sm" data-copy-target="#shared-key"><i class="bi bi-clipboard"></i> Copy</button>
                </div>
            </div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri" hidden></div>
        </div>
    </li>
    <li>
        <span class="step-number">3</span>
        <div class="flex-grow-1">
            <h3 class="h6">Enter the verification code</h3>
            <p class="text-muted">Your app will show a 6-digit code. Enter it below to finish.</p>
            <form id="send-code" asp-area="User" asp-controller="Manage" asp-action="EnableAuthenticator" method="post" class="col-md-8 col-xl-6" novalidate>
                <div asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Code" class="form-control code-input" autocomplete="one-time-code" inputmode="numeric" placeholder="000000" />
                    <label asp-for="Input.Code">Verification code</label>
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary px-4">Verify and enable</button>
            </form>
        </div>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script src="~/js/site.qrcode.js" asp-append-version="true"></script>
}
