@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    var userName = UserManager.GetUserName(User) ?? "Account";
}

<div class="manage-header">
    <span class="avatar avatar-lg" aria-hidden="true">@userName[..1].ToUpperInvariant()</span>
    <div class="min-w-0">
        <h1>Manage your account</h1>
        <div class="text-muted text-truncate">@userName</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-lg-9">
        <div class="card manage-content">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
