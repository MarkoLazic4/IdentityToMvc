@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.ChangePasswordViewModel
@{
    ViewData["Title"] = L["Change password"].Value;
}

<h2 class="page-title">@L["Change password"]</h2>
<p class="page-subtitle">@L["Use a strong password you don't use anywhere else."]</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<form id="change-password-form" asp-area="User" asp-controller="Manage" asp-action="ChangePassword" method="post" class="col-xl-8" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Current password" />
        <label asp-for="Input.OldPassword"></label>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New password" data-strength />
        <label asp-for="Input.NewPassword"></label>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <label asp-for="Input.ConfirmPassword"></label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary px-4">@L["Update password"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
