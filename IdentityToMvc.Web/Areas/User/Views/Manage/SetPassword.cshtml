@model IdentityToMvc.Web.Areas.User.ViewModels.Manage.SetPasswordViewModel
@{
    ViewData["Title"] = "Set password";
}

<h2 class="page-title">Set a password</h2>
<p class="page-subtitle">You don't have a local password yet. Add one so you can also log in without an external provider.</p>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<form id="set-password-form" asp-area="User" asp-controller="Manage" asp-action="SetPassword" method="post" class="col-xl-8" novalidate>
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="New password" data-strength />
        <label asp-for="Input.NewPassword">New password</label>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm new password" />
        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary px-4">Set password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
