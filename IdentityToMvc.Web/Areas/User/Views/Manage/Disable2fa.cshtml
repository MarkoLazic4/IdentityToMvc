@{
    ViewData["Title"] = L["Disable two-factor authentication"].Value;
}

<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />
<h2 class="page-title">@L["Disable two-factor authentication"]</h2>
<p class="page-subtitle">@L["Your account will only be protected by your password."]</p>

<div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle"></i>
    <div>
        <strong>@L["This action only disables 2FA."]</strong>
        <p>
            @L["Disabling 2FA does not change the key used in your authenticator app."]
            <a asp-area="User" asp-controller="Manage" asp-action="ResetAuthenticator">@L["Reset your authenticator key"]</a>
        </p>
    </div>
</div>

<form asp-area="User" asp-controller="Manage" asp-action="Disable2fa" method="post">
    <button class="btn btn-danger" type="submit"><i class="bi bi-shield-x me-1"></i> @L["Disable 2FA"]</button>
    <a class="btn btn-link" asp-area="User" asp-controller="Manage" asp-action="TwoFactorAuthentication">@L["Cancel"]</a>
</form>
