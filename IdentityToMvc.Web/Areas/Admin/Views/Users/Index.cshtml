@model UserListViewModel
@{
    ViewData["Title"] = L["Users"].Value;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
        <h2 class="page-title">@L["Users"]</h2>
        <p class="page-subtitle">@L["{0} accounts", Model.TotalCount]</p>
    </div>
    <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="d-flex gap-2" role="search">
        <input type="search" name="q" id="user-search" value="@Model.Query" class="form-control" placeholder="@L["Search by email"]" aria-label="@L["Search by email"]" />
        <button type="submit" class="btn btn-soft"><i class="bi bi-search"></i></button>
    </form>
</div>
<partial name="_StatusMessage" model="@TempData["StatusMessage"] as string" />

<div class="table-responsive admin-table">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>@L["Email"]</th>
                <th>@L["Status"]</th>
                <th>@L["Roles"]</th>
                <th>@L["Last active"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td class="text-break">
                        <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id" class="fw-semibold user-link">@user.Email</a>
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @if (user.IsLocked)
                            {
                                <span class="badge text-bg-danger">@(user.IsAdminLock ? L["Locked"] : L["Temporarily locked"])</span>
                            }
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge text-bg-warning">@L["Unconfirmed"]</span>
                            }
                            @*#if (TwoFactor)*@
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge text-bg-success">2FA</span>
                            }
                            @*#endif*@
                        </div>
                    </td>
                    <td>@string.Join(", ", user.Roles)</td>
                    <td class="text-muted small text-nowrap">@(user.LastActive?.ToLocalTime().ToString("g") ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="@L["Pages"]">
        <ul class="pagination mb-0">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
