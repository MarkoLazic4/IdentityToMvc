{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=prodserver;Database=prodDb;User Id=prodUser;Password=prodPassword;"
  },
  "SMTP": {
    "Host": "YourOwnHost",
    "Port": 587,
    "EnableSsl": true,
    "Username": "YourOwnUserEmailAddress",
    "Password": "YourOwnPassword",
    "From": "identitytomvc@gmail.com",
    "FromName": "IdentityToMvc"
  },
  "Security": {
    "CheckBreachedPasswords": true,
    "SendSecurityNotifications": true,
    "MaxPasskeysPerUser": 10,
    "PasskeyServerDomain": "",
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
