{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SMTP": {
    "Host": "YourOwnHost",
    "Port": 587,
    "EnableSsl": true,
    "Username": "YourOwnUserEmailAddress",
    "Password": "YourOwnPassword",
    "From": "identitytomvc@gmail.com",
    "FromName": "IdentityToMvc"
  },
  //#if (Google)
  "GoogleClientId": "",
  "GoogleClientSecret": "",
  //#endif
  //#if (Facebook)
  "FacebookAppId": "",
  "FacebookAppSecret": "",
  //#endif
  "Security": {
    //#if (TwoFactor)
    "EnableTwoFactor": true,
    //#endif
    //#if (Passkeys)
    "EnablePasskeys": true,
    "MaxPasskeysPerUser": 10,
    "PasskeyServerDomain": "",
    //#endif
    //#if (Sudo)
    "RequireRecentAuthentication": true,
    //#endif
    "EnableRateLimiting": true,
    //#if (BreachedPasswords)
    "CheckBreachedPasswords": true,
    //#endif
    //#if (Notifications)
    "SendSecurityNotifications": true,
    //#endif
    //#if (AdminRequiresMfa)
    "RequireTwoFactorForAdmins": true,
    //#endif
    "KnownProxies": [],
    "AuditRetentionDays": 365,
    "SessionRetentionDays": 30,
    "DataProtectionCertificatePath": "",
    "DataProtectionCertificatePassword": ""
  },
  //#if (Admin)
  "Admin": {
    "Emails": []
  },
  //#endif
  "Localization": {
    "DefaultCulture": "sr-Latn-RS"
  },
  "AllowedHosts": "*"
}
